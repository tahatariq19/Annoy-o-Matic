import os
import discord
import logging
from discord.ext import commands
from dotenv import load_dotenv
from database import AnnoyanceDB

# Setup Logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
)
logger = logging.getLogger("Main")

load_dotenv()
TOKEN = os.getenv('DISCORD_TOKEN')

class AnnoyBot(commands.Bot):
    def __init__(self):
        intents = discord.Intents.default()
        intents.message_content = True
        intents.members = True
        super().__init__(command_prefix="!", intents=intents)
        self.db = AnnoyanceDB()

    async def setup_hook(self):
        """Async Initialization Hook"""
        logger.info("Initializing Database Connection...")
        await self.db.connect()
        
        logger.info("Loading Extensions...")
        await self.load_extension("cogs.annoyance")
        
        # Sync Global Commands
        logger.info("Syncing Command Tree...")
        await self.tree.sync()
        logger.info("Ready to Annoy.")

    async def close(self):
        """Cleanup Hook"""
        await self.db.close()
        await super().close()

bot = AnnoyBot()

if __name__ == "__main__":
    if not TOKEN:
        logger.critical("DISCORD_TOKEN not found in environment!")
        exit(1)
    
    try:
        bot.run(TOKEN)
    except Exception as e:
        logger.critical(f"Bot Crashed: {e}")
